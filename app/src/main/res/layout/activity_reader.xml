<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical">

    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:background="@color/paper">

        <ScrollView
            android:id="@+id/scroll"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:fillViewport="true">

            <TextView
                android:id="@+id/text"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:lineSpacingMultiplier="1.35"
                android:paddingStart="44dp"
                android:paddingTop="20dp"
                android:paddingEnd="20dp"
                android:paddingBottom="240dp"
                android:textColor="@color/ink"
                android:textSize="21sp" />
        </ScrollView>

        <View
            android:layout_width="2dp"
            android:layout_height="match_parent"
            android:layout_marginStart="30dp"
            android:background="@color/margin_red" />
    </FrameLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@color/bar"
        android:orientation="vertical"
        android:paddingStart="10dp"
        android:paddingTop="8dp"
        android:paddingEnd="10dp"
        android:paddingBottom="10dp">

        <TextView
            android:id="@+id/status"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center"
            android:textColor="@color/ink"
            android:textSize="17sp"
            android:textStyle="bold" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center"
            android:text="@string/tap_hint"
            android:textColor="@color/ink_soft"
            android:textSize="13sp" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <ImageButton
                android:id="@+id/btnFirst"
                style="@style/Dictee.IconButton"
                android:contentDescription="@string/first"
                android:src="@drawable/ic_first" />

            <ImageButton
                android:id="@+id/btnPrev"
                style="@style/Dictee.IconButton"
                android:contentDescription="@string/previous"
                android:src="@drawable/ic_previous" />

            <ImageButton
                android:id="@+id/btnPlay"
                android:layout_width="76dp"
                android:layout_height="76dp"
                android:layout_marginStart="6dp"
                android:layout_marginEnd="6dp"
                android:background="@drawable/btn_play"
                android:contentDescription="@string/play"
                android:scaleType="center"
                android:src="@drawable/ic_play"
                android:tint="@color/on_button_primary" />

            <ImageButton
                android:id="@+id/btnNext"
                style="@style/Dictee.IconButton"
                android:layout_weight="2"
                android:contentDescription="@string/next"
                android:src="@drawable/ic_next" />
        </LinearLayout>
    </LinearLayout>
</LinearLayout>
