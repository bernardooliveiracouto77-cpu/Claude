<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/paper">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingStart="18dp"
        android:paddingEnd="18dp"
        android:paddingBottom="32dp">

        <TextView
            style="@style/Dictee.SectionTitle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/section_parts" />

        <RadioGroup
            android:id="@+id/sizeGroup"
            android:layout_width="match_parent"
            android:layout_height="wrap_content">

            <RadioButton android:id="@+id/size1" android:layout_width="match_parent" android:layout_height="wrap_content" android:minHeight="48dp" android:text="@string/size_1" android:textColor="@color/ink" android:textSize="16sp" />
            <RadioButton android:id="@+id/size2" android:layout_width="match_parent" android:layout_height="wrap_content" android:minHeight="48dp" android:text="@string/size_2" android:textColor="@color/ink" android:textSize="16sp" />
            <RadioButton android:id="@+id/size23" android:layout_width="match_parent" android:layout_height="wrap_content" android:minHeight="48dp" android:text="@string/size_2_3" android:textColor="@color/ink" android:textSize="16sp" />
            <RadioButton android:id="@+id/size34" android:layout_width="match_parent" android:layout_height="wrap_content" android:minHeight="48dp" android:text="@string/size_3_4" android:textColor="@color/ink" android:textSize="16sp" />
        </RadioGroup>

        <TextView
            style="@style/Dictee.SectionTitle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/section_voice" />

        <TextView android:id="@+id/speedLabel" style="@style/Dictee.Label" android:layout_width="match_parent" android:layout_height="wrap_content" />
        <SeekBar android:id="@+id/speedBar" android:layout_width="match_parent" android:layout_height="wrap_content" android:minHeight="48dp" />

        <TextView android:id="@+id/sentencePauseLabel" style="@style/Dictee.Label" android:layout_width="match_parent" android:layout_height="wrap_content" />
        <SeekBar android:id="@+id/sentencePauseBar" android:layout_width="match_parent" android:layout_height="wrap_content" android:minHeight="48dp" />

        <CheckBox
            android:id="@+id/commaCheck"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:minHeight="48dp"
            android:text="@string/comma_pause"
            android:textColor="@color/ink"
            android:textSize="16sp" />

        <TextView android:id="@+id/commaPauseLabel" style="@style/Dictee.Label" android:layout_width="match_parent" android:layout_height="wrap_content" />
        <SeekBar android:id="@+id/commaPauseBar" android:layout_width="match_parent" android:layout_height="wrap_content" android:minHeight="48dp" />

        <TextView android:id="@+id/loopPauseLabel" style="@style/Dictee.Label" android:layout_width="match_parent" android:layout_height="wrap_content" />
        <SeekBar android:id="@+id/loopPauseBar" android:layout_width="match_parent" android:layout_height="wrap_content" android:minHeight="48dp" />

        <TextView style="@style/Dictee.Label" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="@string/voice" />
        <Spinner
            android:id="@+id/voiceSpinner"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:minHeight="48dp" />

        <Button
            android:id="@+id/testVoice"
            style="@style/Dictee.Button"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:text="@string/test_voice" />

        <TextView
            style="@style/Dictee.SectionTitle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/section_taps" />

        <TextView android:id="@+id/sensitivityLabel" style="@style/Dictee.Label" android:layout_width="match_parent" android:layout_height="wrap_content" />
        <SeekBar android:id="@+id/sensitivityBar" android:layout_width="match_parent" android:layout_height="wrap_content" android:minHeight="48dp" />

        <com.dictee.boucle.TapGaugeView
            android:id="@+id/gauge"
            android:layout_width="match_parent"
            android:layout_height="40dp"
            android:layout_marginTop="8dp" />

        <TextView
            android:id="@+id/lastTap"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:text="@string/last_tap_none"
            android:textColor="@color/ink"
            android:textSize="17sp"
            android:textStyle="bold" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:text="@string/gauge_help"
            android:textColor="@color/ink_soft"
            android:textSize="14sp" />

        <TextView style="@style/Dictee.Label" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="@string/triple_action" />
        <RadioGroup
            android:id="@+id/tripleGroup"
            android:layout_width="match_parent"
            android:layout_height="wrap_content">

            <RadioButton android:id="@+id/triplePrev" android:layout_width="match_parent" android:layout_height="wrap_content" android:minHeight="48dp" android:text="@string/triple_previous" android:textColor="@color/ink" android:textSize="16sp" />
            <RadioButton android:id="@+id/tripleFirst" android:layout_width="match_parent" android:layout_height="wrap_content" android:minHeight="48dp" android:text="@string/triple_first" android:textColor="@color/ink" android:textSize="16sp" />
        </RadioGroup>
    </LinearLayout>
</ScrollView>
