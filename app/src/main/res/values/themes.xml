<?xml version="1.0" encoding="utf-8"?>
<resources>
    <style name="Theme.Dictee" parent="Theme.AppCompat.DayNight.DarkActionBar">
        <item name="colorPrimary">@color/bar_primary</item>
        <item name="colorPrimaryDark">@color/bar_primary_dark</item>
        <item name="colorAccent">@color/accent</item>
        <item name="colorControlActivated">@color/accent</item>
        <item name="android:windowBackground">@color/paper</item>
        <item name="android:textColorPrimary">@color/ink</item>
        <item name="android:textColorSecondary">@color/ink_soft</item>
        <item name="android:statusBarColor">@color/bar_primary_dark</item>
        <item name="android:navigationBarColor">@color/bar</item>
    </style>

    <style name="Theme.Dictee.Fullscreen" parent="Theme.Dictee">
        <item name="windowActionBar">false</item>
        <item name="windowNoTitle">true</item>
        <item name="android:windowBackground">@color/handsfree_bg</item>
    </style>

    <style name="Dictee.Button" parent="Widget.AppCompat.Button.Borderless">
        <item name="android:minHeight">56dp</item>
        <item name="android:minWidth">56dp</item>
        <item name="android:paddingStart">18dp</item>
        <item name="android:paddingEnd">18dp</item>
        <item name="android:textSize">17sp</item>
        <item name="android:textAllCaps">false</item>
        <item name="android:textStyle">bold</item>
        <item name="android:background">@drawable/btn_secondary</item>
        <item name="android:textColor">@color/on_button_secondary</item>
    </style>

    <style name="Dictee.Button.Primary">
        <item name="android:background">@drawable/btn_primary</item>
        <item name="android:textColor">@color/on_button_primary</item>
    </style>

    <style name="Dictee.IconButton" parent="">
        <item name="android:layout_width">0dp</item>
        <item name="android:layout_height">56dp</item>
        <item name="android:layout_weight">1</item>
        <item name="android:minWidth">56dp</item>
        <item name="android:background">@drawable/btn_round_secondary</item>
        <item name="android:scaleType">center</item>
        <item name="tint">@color/on_button_secondary</item>
        <item name="android:layout_marginStart">4dp</item>
        <item name="android:layout_marginEnd">4dp</item>
    </style>

    <style name="Dictee.SectionTitle" parent="">
        <item name="android:textSize">18sp</item>
        <item name="android:textStyle">bold</item>
        <item name="android:textColor">@color/ink</item>
        <item name="android:layout_marginTop">20dp</item>
        <item name="android:layout_marginBottom">6dp</item>
    </style>

    <style name="Dictee.Label" parent="">
        <item name="android:textSize">16sp</item>
        <item name="android:textColor">@color/ink</item>
        <item name="android:layout_marginTop">10dp</item>
    </style>
</resources>
